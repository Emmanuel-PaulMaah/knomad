# Copy this file to .env.local. `npm run deploy` writes the NEON_* / AWS_* / DATABASE_*
# values for your own branch; do not commit .env.local.
# Only VITE_* values are bundled into the browser; never put a secret in one.

# Public browser values (from `npm run deploy` and `neon functions get knomadsync`)
VITE_NEON_AUTH_URL=https://<branch-id>-neonauth.<region>.aws.neon.tech/neondb/auth
VITE_NEON_SYNC_URL=https://<branch-id>-knomadsync<function-host-suffix>
VITE_NEON_REALTIME_URL=wss://<realtime-host>

# Pulled by Neon (do not hand-edit unless you know why)
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=
# NEON_AI_GATEWAY_BASE_URL=
# NEON_AI_GATEWAY_TOKEN=
# NEON_REALTIME_URL=
# NEON_REALTIME_SECRET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
