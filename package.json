{
  "name": "knomad",
  "version": "1.0.0",
  "description": "Local-first job search workspace: dashboard, resume tailoring, and application tracker.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 8000",
    "build": "vite build",
    "preview": "vite preview --port 8000",
