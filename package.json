    "@neon/functions": "^0.11.0",
    "@neon/realtime": "^0.2.1",
    "@neondatabase/auth": "^0.7.0-beta",
    "@neondatabase/neon-js": "^0.9.0-beta",
    "hono": "^4.6.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
